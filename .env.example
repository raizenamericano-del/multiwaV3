# ---------------------------------------------------------------------------
# WhatsApp Multi-Device Controller — environment variables
# Copy this file to `.env` and adjust the values.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# LOCAL DEV (SQLite, zero setup — a file next to prisma/schema.prisma):
DATABASE_URL="file:./dev.db"

# RAILWAY / PRODUCTION (PostgreSQL):
# 1. Railway dashboard -> your project -> New -> Database -> Add PostgreSQL
# 2. Railway automatically injects DATABASE_URL into your service when the
#    Postgres plugin is in the same project (Variables -> Reference).
#    It looks like: postgresql://postgres:password@host:5432/railway
# Uncomment and paste it if you are not using the plugin reference:
# DATABASE_URL="postgresql://user:password@host:5432/railway"

# --- Server -----------------------------------------------------------------
# Port the HTTP server listens on (Railway injects PORT automatically).
PORT=3000
HOSTNAME=0.0.0.0

# --- Runtime storage --------------------------------------------------------
# Baileys auth (session) files and downloaded media.
# On Railway, mount a Volume at /app/data so sessions survive redeploys.
WA_AUTH_DIR=./data/auth
WA_MEDIA_DIR=./data/media

# --- Behaviour --------------------------------------------------------------
# Automatically restore + reconnect every stored session on server boot.
WA_AUTO_RESTORE=true

# Ask WhatsApp for FULL message history when a device is linked (heavier on
# CPU/RAM for big accounts). When false, only the recent sync chunk is stored.
WA_SYNC_FULL_HISTORY=false

# Safety cap for messages imported from history sync (per session).
WA_HISTORY_MESSAGE_LIMIT=3000

# Log level: trace | debug | info | warn | error | silent
LOG_LEVEL=info
